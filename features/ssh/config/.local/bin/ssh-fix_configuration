#! /usr/bin/env sh

set -e
set -u


# Fix permissions
chmod 0700 ~/.ssh
chmod 0400 ~/.ssh/id_*
chmod 0600 ~/.ssh/config


# for macos use --apple-use-keychain
ADDTL_OPTS=""
case "$(uname)" in
    Darwin) ADDTL_OPTS="--apple-use-keychain" ;;
esac

# Find and add all private keys in ~/.ssh/
for key in ~/.ssh/id_*; do
    case "$key" in
        *.pub) continue ;;
        *)
            [ -f "$key" ] || continue
            ssh-add $ADDTL_OPTS "$key"
            ;;
    esac
done

# Print check
ssh-add -l

exit 0
