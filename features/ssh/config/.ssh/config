###################
# GLOBAL SETTINGS #
###################
# Configuration for every host
Host *
    ServerAliveInterval 240
    IgnoreUnknown AddKeysToAgent,UseKeychain
    AddKeysToAgent yes
    UseKeychain yes

###################
# PERSONAL GITHUB #
###################
# SSH key for my personal GitHub account
# You need to clone the repo using the host `github.com-personal`
Host github.com-personal
    HostName github.com
    IdentityFile ~/.ssh/id_personal
    IdentitiesOnly yes

###############
# WORK GITHUB #
###############
# SSH key for my GitHub work account
# You need to clone the repo using the host `github.com-work`
Host github.com-work
    HostName github.com
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes

##################
# DEFAULT GITHUB #
##################
# Default identity for plain github.com (deterministic, ignores agent order)
Host github.com
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
